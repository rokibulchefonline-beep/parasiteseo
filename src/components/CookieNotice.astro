---
// The site sets no non-essential cookies out of the box, so this is an
// informational notice only. If you add analytics or advertising, load those
// scripts only after the visitor clicks "Accept" (UK GDPR / PECR).
---

<div class="cookie" id="cookie-notice" role="region" aria-label="Cookie notice" hidden>
  <p>
    We use only essential storage to run this site. If you accept, we may also use analytics to understand
    what readers enjoy. <a href="/cookies/">Cookie policy</a>
  </p>
  <div class="actions">
    <button type="button" class="btn" data-consent="accepted">Accept</button>
    <button type="button" class="btn secondary" data-consent="rejected">Reject</button>
  </div>
</div>

<script is:inline>
  (function () {
    var key = 'cookie-consent';
    var el = document.getElementById('cookie-notice');
    var stored = null;
    try { stored = localStorage.getItem(key); } catch (e) {}
    if (!stored) el.hidden = false;
    el.addEventListener('click', function (e) {
      var choice = e.target && e.target.getAttribute('data-consent');
      if (!choice) return;
      try { localStorage.setItem(key, choice); } catch (e) {}
      el.hidden = true;
      document.dispatchEvent(new CustomEvent('cookie-consent', { detail: choice }));
    });
  })();
</script>

<style>
  .cookie {
    position: fixed;
    inset: auto 16px 16px 16px;
    max-width: 560px;
    margin-inline: auto;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    padding: 1rem 1.25rem;
    z-index: 50;
    font-size: 0.9rem;
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie p {
    margin: 0 0 0.75rem;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
  }
  .secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule);
  }
</style>
