---
import { Image } from 'astro:assets';
import { articleUrl, formatDate, getAuthor, getCategory, type Article } from '../lib/articles';

interface Props {
  article: Article;
  size?: 'lead' | 'default' | 'compact';
  showImage?: boolean;
}

const { article, size = 'default', showImage = true } = Astro.props;
const { data } = article;
const category = getCategory(data.category);
const author = getAuthor(data.author);
const Heading = size === 'lead' ? 'h2' : 'h3';
---

<article class={`card ${size}`}>
  {
    showImage && size !== 'compact' && (
      <a href={articleUrl(article)} class="media" tabindex="-1" aria-hidden="true">
        {data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={[400, 800, 1200]}
            sizes={size === 'lead' ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 30vw, 100vw'}
            loading={size === 'lead' ? 'eager' : 'lazy'}
          />
        ) : (
          <span class={`placeholder cat-${data.category}`}>{category.name}</span>
        )}
      </a>
    )
  }
  <div class="body">
    <a class="kicker" href={`/category/${category.slug}/`}>{category.name}</a>
    <Heading class="title"><a href={articleUrl(article)}>{data.title}</a></Heading>
    {size !== 'compact' && <p class="desc">{data.description}</p>}
    <p class="meta">
      {author.name} · <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
    </p>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--rule);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .media :global(img) {
    transform: scale(1.03);
  }
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.92);
    background: linear-gradient(135deg, var(--c1), var(--c2));
  }
  .cat-news { --c1: #0f2340; --c2: #2b4f86; }
  .cat-business { --c1: #1f3b2d; --c2: #3f7a5a; }
  .cat-culture { --c1: #4a1942; --c2: #8e3b7a; }
  .cat-food-drink { --c1: #7a2e12; --c2: #c56a2c; }
  .cat-travel { --c1: #0f4c5c; --c2: #3a8ea3; }
  .cat-property { --c1: #3b3355; --c2: #6c5f95; }
  .cat-lifestyle { --c1: #6b2737; --c2: #b3122d; }
  .cat-technology { --c1: #222838; --c2: #4b5875; }

  .title {
    margin: 0;
    font-size: 1.25rem;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .meta {
    margin: 0;
  }
  .lead .title {
    font-size: clamp(1.75rem, 4vw, 2.6rem);
  }
  .lead .desc {
    font-size: 1.1rem;
  }
  .compact {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .compact .body {
    display: grid;
    gap: 0.3rem;
  }
  .compact .title {
    font-size: 1.05rem;
  }
</style>
