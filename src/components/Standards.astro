---
import { POLICIES, SITE } from '../config';
---

<section class="standards" aria-labelledby="standards-title">
  <h2 id="standards-title">Why you can trust {SITE.name}</h2>
  <div class="items">
    <div>
      <h3>Official sources first</h3>
      <p>Guides on law, safety, tax and money are based on GOV.UK, the Food Standards Agency, HMRC and other official sources, and link to them.</p>
      <a href={POLICIES.editorial}>Editorial policy</a>
    </div>
    <div>
      <h3>Connections disclosed</h3>
      <p>When an article features a business connected to our publisher, it says so at the top. We list every one publicly.</p>
      <a href={POLICIES.ownership}>Ownership &amp; funding</a>
    </div>
    <div>
      <h3>Corrections in the open</h3>
      <p>Every article has a "Report an error" link. We check every report and add a dated note when we correct something.</p>
      <a href={POLICIES.corrections}>Corrections policy</a>
    </div>
  </div>
</section>

<style>
  .standards {
    margin-top: 3.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
  }
  h2 {
    font-size: 1.5rem;
  }
  .items {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .items {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }
  p {
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
