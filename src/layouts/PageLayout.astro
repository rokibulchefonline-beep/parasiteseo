---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  intro?: string;
  noindex?: boolean;
}
const { title, description, intro, noindex } = Astro.props;
---

<BaseLayout title={title} description={description ?? intro} noindex={noindex}>
  <div class="wrap">
    <header class="page-head">
      <h1>{title}</h1>
      {intro && <p>{intro}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
