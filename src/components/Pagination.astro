---
interface Props {
  prev?: string;
  next?: string;
  current: number;
  last: number;
}
const { prev, next, current, last } = Astro.props;
---

{
  last > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {prev ? <a href={prev} rel="prev">← Newer</a> : <span />}
      <span class="meta">Page {current} of {last}</span>
      {next ? <a href={next} rel="next">Older →</a> : <span />}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
</style>
