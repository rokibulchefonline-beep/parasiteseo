{
  "name": "uk-magazine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static UK magazine website built with Astro, deployable to Netlify, Vercel and Cloudflare Pages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "images": "node scripts/fetch-images.mjs",
    "deploy:cloudflare": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "wrangler": "^4.137.0"
  }
}
